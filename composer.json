{
    "name": "sikandarmoyaldev/my-profile-plugin",
    "description": "A Filament plugin for managing user profile information",
    "keywords": [
        "sikandarmoyaldev",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "my-profile-plugin"
    ],
    "homepage": "https://github.com/sikandarmoyaldev/my-profile-plugin",
    "support": {
        "issues": "https://github.com/sikandarmoyaldev/my-profile-plugin/issues",
        "source": "https://github.com/sikandarmoyaldev/my-profile-plugin"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Sikandar",
            "email": "sikandar.moyal.dev@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0@beta",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Sikandarmoyaldev\\MyProfilePlugin\\": "src/",
            "Sikandarmoyaldev\\MyProfilePlugin\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sikandarmoyaldev\\MyProfilePlugin\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sikandarmoyaldev\\MyProfilePlugin\\MyProfilePluginServiceProvider"
            ],
            "aliases": {
                "MyProfilePlugin": "Sikandarmoyaldev\\MyProfilePlugin\\Facades\\MyProfilePlugin"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "audit": {
            "ignore": [
                "PKSA-5bdf-2x61-v43c"
            ],
            "block-insecure": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
